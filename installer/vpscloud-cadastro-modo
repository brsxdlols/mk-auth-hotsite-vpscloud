#!/bin/sh
set -eu
MODE=${1:-}
CONFIG=${VPSCLOUD_WEBROOT:-/var/www}/vpscloud-config.php
if [ "$MODE" != whatsapp ] && [ "$MODE" != sistema ]; then
  echo 'Uso: vpscloud-cadastro-modo whatsapp|sistema' >&2
  exit 2
fi
printf "<?php\nreturn ['cadastro_modo' => '%s'];\n" "$MODE" > "$CONFIG"
chmod 0644 "$CONFIG"
echo "Modo de cadastro VPS CLOUD: $MODE"
